<!-- We prefix this file with jcache to avoid more config override -->

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">
    <bean id="propertyConfigurer"
          class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="locations">
            <list>
                <value>classpath:redis/redis.xml</value>
            </list>
        </property>
    </bean>
    <bean id="propertyLoader"
          class="org.springframework.beans.factory.config.PropertiesFactoryBean">
        <property name="locations">
            <value>classpath:redis/redis.xml</value>
        </property>
    </bean>
    <bean id="redisConfig" class="no.idporten.eidas.redis.cache.RedisConfig">
        <property name="redisPassword" value="${redis.password}"/>
        <property name="redisHost" value = "${redis.host}"/>
        <property name="redisPort" value = "${redis.port}"/>
    </bean>
    <bean id="redisMetadataConfig" class="no.idporten.eidas.redis.cache.metadata.RedisMetadataConfig">
    </bean>

    <!-- a new cachemanager that maps keys to the caches-->
    <bean id="connectorCacheProvider" class="no.idporten.eidas.redis.cache.EidasRedisCacheManager">
        <constructor-arg>
            <map>
                <entry key="antiReplayConnector" value-ref="springConnectorCMapAntiReplayProviderImpl"/>
                <entry key="specificCorrelationConnector" value-ref="springConnectorCMapspecificLightCorProviderImpl"/>
                <entry key="samlCorrelationConnector" value-ref="springConnectorCMapCorProviderImpl"/>
                <entry key="flowIdConnector" value-ref="connectorFlowIdCacheImpl"/>
                <entry key="metadataConnector" value-ref="metadataCacheImpl"/>
                <entry key="metadataRolloverConnector" value-ref="metadataRolloverCacheImpl"/>
                <entry key="specificNodeConnectorRequestCache" value-ref="specificNodeConnectorRequestCacheImpl"/>
                <entry key="nodeSpecificConnectorResponseCache" value-ref="nodeSpecificConnectorResponseCacheImpl"/>
            </map>
        </constructor-arg>
    </bean>

    <!-- Caches in cachemanager -->
    <bean id="springConnectorCMapAntiReplayProviderImpl"
          class="no.idporten.eidas.redis.cache.RedisCache">
        <constructor-arg value="antiReplayCacheConnector"/>
        <constructor-arg type="long" value="${redis.timeout}"/>
        <constructor-arg ref="redisNodeTemplate"/>
    </bean>

    <bean id="springConnectorCMapCorProviderImpl" 
          class="no.idporten.eidas.redis.cache.RedisCache">
        <constructor-arg value="connectorRequestCorrelationCacheService"/>
        <constructor-arg type="long" value="${redis.timeout}"/>
        <constructor-arg ref="redisNodeTemplate"/>
    </bean>

    <bean id="springConnectorCMapspecificLightCorProviderImpl" 
          class="no.idporten.eidas.redis.cache.RedisCache">
        <constructor-arg value="specificConnectorLtRequestCorrelationCacheService"/>
        <constructor-arg type="long" value="${redis.timeout}"/>
        <constructor-arg ref="redisNodeTemplate"/>
    </bean>

    <bean id="connectorFlowIdCacheImpl" 
          class="no.idporten.eidas.redis.cache.RedisCache">
        <constructor-arg value="connectorFlowIdCacheService"/>
        <constructor-arg type="long" value="${redis.timeout}"/>
        <constructor-arg ref="redisNodeTemplate"/>
    </bean>

    <bean id="metadataCacheImpl" 
          class="no.idporten.eidas.redis.cache.metadata.SimpleMetadataCaching">
        <constructor-arg type="java.lang.String" value="metadata"/>
        <constructor-arg type="long" value="-1"/>
        <constructor-arg ref="redisMetadataTemplate"/>
    </bean>

    <bean id="metadataRolloverCacheImpl" 
          class="no.idporten.eidas.redis.cache.metadata.SimpleMetadataCaching" lazy-init="true">
        <constructor-arg type="java.lang.String" value="metadata"/>
        <constructor-arg type="long" value="-1"/>
        <constructor-arg ref="redisMetadataTemplate"/>
    </bean>

    <!--communication caches-->


    <bean id="specificNodeConnectorRequestCacheImpl" class="no.idporten.eidas.redis.cache.RedisCache">
        <constructor-arg type="java.lang.String" value="${specific.node.connector.request.cache.name}"/>
        <constructor-arg type="long" value="${redis.timeout}"/>
        <constructor-arg ref="redisMetadataTemplate"/>
    </bean>

    <bean id="nodeSpecificConnectorResponseCacheImpl" class="no.idporten.eidas.redis.cache.RedisCache">
        <constructor-arg type="java.lang.String" value="${node.specific.connector.response.cache.name}"/>
        <constructor-arg type="long" value="${redis.timeout}"/>
        <constructor-arg ref="redisMetadataTemplate"/>
    </bean>

    <bean id="specificNodeConnectorRequestCache" class="eu.eidas.specificcommunication.CommunicationCache">
        <constructor-arg ref="connectorCacheProvider"/>
        <constructor-arg value="specificNodeConnectorRequestCache"/>
    </bean>

    <bean id="nodeSpecificConnectorResponseCache" class="eu.eidas.specificcommunication.CommunicationCache">
        <constructor-arg ref="connectorCacheProvider"/>
        <constructor-arg value="nodeSpecificConnectorResponseCache"/>

    </bean>

    <!-- Metrics binders -->
    <bean id="eidasTelemetryRegistry" class="no.idporten.eidas.redis.cache.metrics.EidasTelemetryRegistry" lazy-init="true"/>
    <bean id="connectorCacheMetricsBinder" class="no.idporten.eidas.redis.cache.metrics.RedisCacheMetricsBinder" lazy-init="true">
        <constructor-arg ref="connectorCacheProvider"/>
    </bean>
    <bean id="specificConnectorCommunicationCacheMetricsBinder" class="no.idporten.eidas.redis.cache.metrics.RedisCacheMetricsBinder"
          lazy-init="true">
        <constructor-arg ref="connectorCacheProvider"/>
    </bean>

</beans>
